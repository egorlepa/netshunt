package templates

import (
	"time"

	"github.com/egorlepa/netshunt/internal/blocklist"
	"github.com/egorlepa/netshunt/internal/config"
)

// SourceView pairs a preset definition with its persisted state for rendering.
type SourceView struct {
	Preset blocklist.Source
	State  blocklist.SourceState
}

// BlocklistStats is the live matcher as the strip shows it.
type BlocklistStats struct {
	Domains   int       // entries of the installed matcher
	AppliedAt time.Time // when it was built, zero before the first build
	MemBytes  int       // SuffixSet data + offsets
}

// BlocklistPageData is what the Blocklist page renders.
type BlocklistPageData struct {
	Enabled      bool
	Response     config.BlocklistResponse
	AutoEnabled  bool
	Schedule     string
	ScheduleText string
	Sources      []SourceView
	Stats        BlocklistStats
	Now          time.Time
}

templ BlocklistPage(d BlocklistPageData) {
	@Layout("Blocklist", "blocklist") {
		<div id="blocklist-content">
			@BlocklistContent(d)
		</div>
		<script>
			// A source toggle flips its dot at once; a failed request flips both back.
			document.addEventListener('change', function (ev) {
				if (!ev.target.matches('.b-head .tg input')) return;
				ev.target.closest('.head').querySelector('.dot').classList.toggle('on', ev.target.checked);
			});
			document.body.addEventListener('htmx:afterRequest', function (e) {
				var elt = e.detail.elt;
				if (e.detail.successful || !elt.matches || !elt.matches('.b-head .tg input')) return;
				elt.checked = !elt.checked;
				elt.closest('.head').querySelector('.dot').classList.toggle('on', elt.checked);
			});
		</script>
	}
}

templ BlocklistContent(d BlocklistPageData) {
	<div class="toolbar plain">
		<h1>Blocklist</h1>
		<div class="actions">
			<button
				class="btn"
				hx-post="/blocklist/update"
				hx-target="#blocklist-content"
				hx-swap="innerHTML"
				hx-disabled-elt="this"
			>
				Update enabled
				<span class="htmx-indicator"><span class="spinner"></span></span>
			</button>
		</div>
	</div>
	<div class="inline-form">
		<span class="lbl">
			<label class="tg">
				<input
					type="checkbox"
					id="bl-enabled"
					name="enabled"
					value="1"
					autocomplete="off"
					if d.Enabled {
						checked
					}
					hx-put="/blocklist/enabled"
					hx-trigger="change"
					hx-swap="none"
					hx-disabled-elt="this"
				/>
				<i></i>
			</label>
			<label for="bl-enabled">DNS blocking</label>
		</span>
		<span class="sep"></span>
		<label>
			Answer
			<select name="response" hx-put="/blocklist/response" hx-trigger="change" hx-swap="none" hx-disabled-elt="this" autocomplete="off">
				<option value="nxdomain" if d.Response == config.BlocklistResponseNXDomain { selected }>NXDOMAIN</option>
				<option value="nodata" if d.Response == config.BlocklistResponseNoData { selected }>NODATA</option>
				<option value="zero" if d.Response == config.BlocklistResponseZero { selected }>0.0.0.0</option>
			</select>
		</label>
		<span class="sep"></span>
		<form class="grp" hx-put="/blocklist/auto-update" hx-trigger="change" hx-target="#bcronh" hx-swap="innerHTML">
			<label class="chk"><input type="checkbox" name="enabled" value="1" autocomplete="off" if d.AutoEnabled { checked }/> auto-update</label>
			<input type="text" class="cron" name="schedule" value={ d.Schedule } aria-label="cron schedule" autocomplete="off" spellcheck="false"/>
			<span class="muted" id="bcronh">{ d.ScheduleText }</span>
		</form>
	</div>
	@BlocklistStrip(d.Stats, false)
	<div class="list">
		for _, sv := range d.Sources {
			@BlocklistSourceRow(sv, d.Now)
		}
	</div>
	<div class="sec">Test a domain</div>
	<form class="inline-form check-form" hx-get="/blocklist/check" hx-target="#bl-res" hx-swap="innerHTML">
		<input type="text" name="domain" placeholder="ads.example.com" autocomplete="off" spellcheck="false" required/>
		<button class="btn btn-sm" type="submit">Check</button>
		<div class="check-res" id="bl-res"></div>
	</form>
}

// BlocklistStrip is the live matcher summary; oob marks it for an
// out-of-band swap after a change that rebuilds the matcher.
templ BlocklistStrip(st BlocklistStats, oob bool) {
	<div
		class="strip"
		id="bl-strip"
		if oob {
			hx-swap-oob="true"
		}
	>
		<span><b>@Num(st.Domains)</b> domains loaded</span>
		<span>applied <b>@appliedAt(st.AppliedAt)</b></span>
		<span>matcher <b>{ HumanBytes(int64(st.MemBytes)) }</b></span>
	</div>
}

templ BlocklistSourceRow(sv SourceView, now time.Time) {
	<div class="row" id={ "src-" + SlugID(sv.Preset.ID) } data-id={ sv.Preset.ID }>
		<div class="head b-head">
			<span class={ "dot", templ.KV("on", sv.State.Enabled) }></span>
			<span class="name"><span class="t">{ sv.Preset.Name }</span></span>
			<span class="num">@numOrDash(sv.State.DomainCount)</span>
			if sv.State.LastError != "" {
				<span class="muted err" title={ sv.State.LastError }>Update failed: { sv.State.LastError }</span>
			} else {
				<span class="muted" title={ sv.Preset.Description }>{ sv.Preset.Description }</span>
			}
			if sv.State.LastFetched.IsZero() {
				<span class="muted when">never</span>
			} else {
				<span class="muted when">
					<time datetime={ sv.State.LastFetched.UTC().Format(time.RFC3339) } data-fmt="rel" title={ sv.State.LastFetched.Format("2006-01-02 15:04") }>{ RelTime(sv.State.LastFetched, now) }</time>
				</span>
			}
			<label class="tg" title="Use this source">
				<input
					type="checkbox"
					name="enabled"
					autocomplete="off"
					if sv.State.Enabled {
						checked
					}
					hx-put={ "/blocklist/sources/" + sv.Preset.ID + "/enabled" }
					hx-trigger="change"
					hx-swap="none"
					hx-disabled-elt="this"
				/>
				<i></i>
			</label>
			<button
				class="btn btn-sm"
				hx-post={ "/blocklist/sources/" + sv.Preset.ID + "/update" }
				hx-target={ "#src-" + SlugID(sv.Preset.ID) }
				hx-swap="outerHTML"
				hx-disabled-elt="this"
			>
				Update
				<span class="htmx-indicator"><span class="spinner"></span></span>
			</button>
		</div>
	</div>
}

// BlocklistCheck answers "Test a domain".
templ BlocklistCheck(domain, suffix string, blocked, enabled bool) {
	if blocked && enabled {
		<span class="bad">Blocked:</span> <b>{ domain }</b> by suffix <b>{ suffix }</b>.
	} else if blocked {
		<b>{ domain }</b> matches suffix <b>{ suffix }</b>, but DNS blocking is off.
	} else {
		<span class="ok">Not blocked:</span> <b>{ domain }</b> matches no loaded entry.
	}
}

templ appliedAt(t time.Time) {
	if t.IsZero() {
		never
	} else {
		@LocalTime(t, "time")
	}
}

templ numOrDash(n int) {
	if n > 0 {
		@Num(n)
	} else {
		-
	}
}
