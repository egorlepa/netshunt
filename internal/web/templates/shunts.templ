package templates

import "github.com/egorlepa/netshunt/internal/shunt"

templ ShuntsPage(shunts []ShuntView) {
	@Layout("Shunts", "shunts") {
		<div class="flex-between mb-16">
			<h1>Shunts</h1>
			<div class="flex gap-8 flex-wrap toolbar-actions">
				<button id="toggle-all-btn" class="btn btn-sm" onclick="toggleAllEntries()">Expand All</button>
				<a href="/shunts/export" class="btn btn-sm">Export</a>
				<button class="btn btn-sm" onclick="document.getElementById('import-form').style.display=document.getElementById('import-form').style.display==='none'?'block':'none'">
					Import
				</button>
				<button class="btn btn-sm btn-accent" onclick="document.getElementById('create-form').style.display='block'">
					New Shunt
				</button>
			</div>
		</div>
		<div id="import-form" class="card mb-16" style="display:none">
			<h2>Import Shunts</h2>
			<form
				hx-post="/shunts/import"
				hx-target="#shunt-list"
				hx-swap="innerHTML"
				hx-encoding="multipart/form-data"
				hx-on::after-request="if(event.detail.successful){this.reset();this.closest('.card').style.display='none'}"
				class="mt-8"
			>
				<textarea name="body" rows="6" placeholder="Paste shunts YAML here..." required></textarea>
				<div class="mt-8">
					<button class="btn btn-accent" type="submit" hx-disabled-elt="this">
						Import
						<span class="htmx-indicator"><span class="spinner"></span></span>
					</button>
				</div>
			</form>
		</div>
		<div id="create-form" class="card mb-16" style="display:none">
			<h2>Create Shunt</h2>
			<form
				hx-post="/shunts"
				hx-target="#shunt-list"
				hx-swap="innerHTML"
				hx-disabled-elt="find button[type='submit']"
				hx-on::after-request="if(event.detail.successful){this.reset();this.closest('.card').style.display='none'}"
				class="flex gap-8 mt-8 stack-sm"
			>
				<input type="text" name="name" placeholder="Shunt name" required/>
				<input type="text" name="description" placeholder="Description (optional)"/>
				<button class="btn btn-accent" type="submit">
					Create
					<span class="htmx-indicator"><span class="spinner"></span></span>
				</button>
			</form>
		</div>
		<div id="shunt-list">
			@ShuntList(shunts)
		</div>
		<script>
			var _expandedShunts = new Set();
			function _applyShuntState(card) {
				var slug = card.id.replace('shunt-', '');
				var el = card.querySelector('.entries-section');
				var arrow = card.querySelector('.expand-arrow');
				var expanded = _expandedShunts.has(slug);
				if (el) el.style.display = expanded ? '' : 'none';
				if (arrow) arrow.classList.toggle('expanded', expanded);
			}
			function toggleShunt(slug) {
				if (_expandedShunts.has(slug)) { _expandedShunts.delete(slug); } else { _expandedShunts.add(slug); }
				var card = document.getElementById('shunt-' + slug);
				if (card) _applyShuntState(card);
			}
			function toggleAllEntries() {
				var cards = document.querySelectorAll('.card[id^="shunt-"]');
				var btn = document.getElementById('toggle-all-btn');
				var anyCollapsed = Array.from(cards).some(function(c) {
					return !_expandedShunts.has(c.id.replace('shunt-', ''));
				});
				cards.forEach(function(c) {
					var slug = c.id.replace('shunt-', '');
					if (anyCollapsed) { _expandedShunts.add(slug); } else { _expandedShunts.delete(slug); }
					_applyShuntState(c);
				});
				btn.textContent = anyCollapsed ? 'Collapse All' : 'Expand All';
			}
			document.body.addEventListener('htmx:afterSettle', function(e) {
				var elt = e.detail.elt;
				if (!elt || !elt.id || !elt.id.startsWith('shunt-')) return;
				// Only re-expand when the whole card was replaced (add/bulk entry swaps the card outerHTML).
				// Toggle and entry-only swaps target child elements, so expansion state is preserved as-is.
				var slug = elt.id.replace('shunt-', '');
				_expandedShunts.add(slug);
				var card = document.getElementById('shunt-' + slug);
				if (card) _applyShuntState(card);
			});
			function autoResize(el) {
				if (!el._minH) el._minH = el.offsetHeight;
				el.style.height = 'auto';
				el.style.height = Math.max(el.scrollHeight, el._minH) + 'px';
			}
			document.addEventListener('input', function(e) {
				if (e.target.matches('textarea.auto-resize')) autoResize(e.target);
			});
		</script>
	}
}

templ ShuntList(shunts []ShuntView) {
	if len(shunts) == 0 {
		<div class="card">
			<p class="text-muted">No shunts configured. Create one to get started.</p>
		</div>
	}
	for _, s := range shunts {
		@ShuntCard(s)
	}
}

templ ShuntToggle(s shunt.Shunt) {
	<label class="toggle" id={ "toggle-" + SlugID(s.Name) }>
		if s.Enabled {
			<input
				type="checkbox"
				checked
				hx-put={ shuntPath(s.Name) + "/disable" }
				hx-target={ "#toggle-" + SlugID(s.Name) }
				hx-swap="outerHTML"
			/>
		} else {
			<input
				type="checkbox"
				hx-put={ shuntPath(s.Name) + "/enable" }
				hx-target={ "#toggle-" + SlugID(s.Name) }
				hx-swap="outerHTML"
			/>
		}
		<span class="slider"></span>
	</label>
}

templ ShuntCard(v ShuntView) {
	if v.IsGeosite() {
		@geositeShuntCard(v)
	} else {
		@manualShuntCard(v)
	}
}

templ shuntHead(v ShuntView) {
	<div class="shunt-head mb-8">
		<div class="shunt-head-main shunt-header" data-shunt={ SlugID(v.Name) } onclick="toggleShunt(this.dataset.shunt)">
			<span class="expand-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></span>
			<div class="shunt-title">
				<div class="shunt-name-row">
					<h2>{ v.Name }</h2>
					if v.IsGeosite() {
						<span class="badge badge-yellow" title={ v.Source }>geosite</span>
					}
					<span class="entry-count">{ itoa(v.Count) } entries</span>
					if v.NoData != "" {
						<span class="badge badge-red" title="This shunt routes nothing until the geosite database has the category">{ v.NoData }</span>
					}
				</div>
				if v.IsGeosite() {
					<div class="shunt-desc text-muted text-sm mono">{ v.Source }</div>
				}
				if v.Description != "" {
					<div class="shunt-desc text-muted text-sm">{ v.Description }</div>
				}
			</div>
		</div>
		<div class="shunt-controls">
			@ShuntToggle(v.Shunt)
			<button
				class="btn btn-sm btn-danger"
				hx-delete={ shuntPath(v.Name) }
				hx-target={ "#shunt-" + SlugID(v.Name) }
				hx-swap="outerHTML"
				hx-confirm={ "Delete shunt \"" + v.Name + "\"?" }
			>Delete</button>
		</div>
	</div>
}

// geositeShuntCard is a reference to a geosite category: the entries come
// from the database and are loaded only when the card is expanded.
templ geositeShuntCard(v ShuntView) {
	<div class="card" id={ "shunt-" + SlugID(v.Name) }>
		@shuntHead(v)
		<div class="entries-section" id={ "entries-" + SlugID(v.Name) } style="display:none">
			<div
				id={ "entry-items-" + SlugID(v.Name) }
				hx-get={ shuntPath(v.Name) + "/entries" }
				hx-trigger="intersect once"
				hx-swap="innerHTML"
			>
				<p class="text-muted text-sm">Loading entries... <span class="spinner"></span></p>
			</div>
			<div class="text-muted text-sm mt-8">Read-only: managed from the <a href="/geosite">Geosite</a> page.</div>
		</div>
	</div>
}

templ manualShuntCard(v ShuntView) {
	<div class="card" id={ "shunt-" + SlugID(v.Name) }>
		@shuntHead(v)
		<div class="entries-section" id={ "entries-" + SlugID(v.Name) } style="display:none">
			<div id={ "entry-items-" + SlugID(v.Name) }>
				@EntryList(SlugID(v.Name), v.Name, v.Entries, false)
			</div>
			<form
				hx-post={ shuntPath(v.Name) + "/entries/bulk" }
				hx-target={ "#shunt-" + SlugID(v.Name) }
				hx-swap="outerHTML"
				hx-disabled-elt="find textarea, find button[type='submit']"
				hx-on::after-request="if(event.detail.successful) this.reset()"
				class="mt-8"
			>
				<div class="flex gap-8 items-center stack-sm">
					<textarea name="values" class="auto-resize" rows="2" placeholder="domain.com, 1.2.3.4, 10.0.0.0/8" required></textarea>
					<button class="btn btn-sm btn-accent" type="submit">
						Add
						<span class="htmx-indicator"><span class="spinner"></span></span>
					</button>
				</div>
				<div class="text-muted text-sm mt-8">Prefixes: <span class="mono">full:</span>, <span class="mono">keyword:</span>, <span class="mono">regexp:</span></div>
			</form>
		</div>
	</div>
}

// GeositeEntryList is the lazily loaded, read-only entry list of a geosite
// shunt.
templ GeositeEntryList(shuntSlug string, shuntName string, entries []shunt.Entry, noData string) {
	if noData != "" {
		<p class="text-muted text-sm">No entries: { noData }.</p>
	} else {
		@EntryList(shuntSlug, shuntName, entries, true)
	}
}

templ EntryList(shuntSlug string, shuntName string, entries []shunt.Entry, readOnly bool) {
	if len(entries) == 0 {
		<p class="text-muted text-sm">No entries yet.</p>
	} else {
		<ul class="entry-list">
			for _, e := range sortedEntries(entries) {
				<li class="entry-item">
					<span>{ e.Value }</span>
					if !e.Valid() {
						<span class="badge badge-red" title="Invalid entry, ignored by the DNS matcher and ipset">not applied</span>
					}
					if !readOnly {
						<button
							class="btn btn-sm btn-danger"
							hx-delete={ entryPath(shuntName, e.Value) }
							hx-target={ "#entry-items-" + shuntSlug }
							hx-swap="innerHTML"
						>&times;</button>
					}
				</li>
			}
		</ul>
	}
}
