package templates

import "github.com/egorlepa/netshunt/internal/shunt"

// ShuntsPage is a sticky toolbar over a dense list of shunt rows; a row
// expands in place into its entries and settings. Search, expand state,
// drag-and-drop reordering and the optimistic toggle live in
// /static/shunts.js; every change goes through the htmx endpoints.
templ ShuntsPage(d ShuntsPageData) {
	@Layout("Shunts", "shunts") {
		<div class="sp" id="shunts-page">
			<div class="toolbar plain static">
				<h1>Shunts</h1>
				<div class="actions">
					<button type="button" class="btn" id="expand-all" title="Expand all">
						<span class="btn-text">Expand all</span>
						<svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 9 12 4 17 9"></polyline><polyline points="7 15 12 20 17 15"></polyline></svg>
					</button>
					<button type="button" class="btn" data-form="import-form">Import</button>
					<a class="btn" href="/shunts/export">Export</a>
					<button type="button" class="btn btn-accent" data-form="create-form">+ New</button>
				</div>
			</div>
			<div id="import-form" class="sp-form" hidden>
				<form
					hx-post="/shunts/import"
					hx-target="#shunt-list"
					hx-swap="innerHTML"
					hx-encoding="multipart/form-data"
					hx-disabled-elt="find button[type='submit']"
					hx-on::after-request="if(event.detail.successful){this.reset();this.parentNode.hidden=true}"
				>
					<textarea name="body" rows="6" placeholder="Paste shunts YAML here (the format Export downloads)" required></textarea>
					<div class="sp-form-actions">
						<button class="btn btn-accent" type="submit">
							Import
							<span class="htmx-indicator"><span class="spinner"></span></span>
						</button>
						<button class="btn btn-ghost" type="button" data-form="import-form">Cancel</button>
					</div>
				</form>
			</div>
			<div id="create-form" class="sp-form" hidden>
				<form
					class="sp-form-row"
					hx-post="/shunts"
					hx-target="#shunt-list"
					hx-swap="innerHTML"
					hx-disabled-elt="find button[type='submit']"
					hx-on::after-request="if(event.detail.successful){this.reset();this.parentNode.hidden=true}"
				>
					<input type="text" name="name" placeholder="Shunt name" autocomplete="off" required/>
					<input type="text" name="description" placeholder="Description (optional)" autocomplete="off"/>
					<button class="btn btn-accent" type="submit">
						Create
						<span class="htmx-indicator"><span class="spinner"></span></span>
					</button>
					<button class="btn btn-ghost" type="button" data-form="create-form">Cancel</button>
				</form>
			</div>
			<div class="strip">
				<span><b id="n-on">{ itoa(d.Enabled()) }</b> of <b id="n-all">{ itoa(len(d.Shunts)) }</b> enabled</span>
				<span><b id="n-entries">@Num(d.Entries())</b> entries</span>
				if d.IPSetMembers >= 0 {
					<span>
						<b>@Num(d.IPSetMembers)</b> IPs in set
					</span>
				}
				<span class="grow"></span>
				<span>drag the handle to reorder</span>
			</div>
			<div class="listbar">
				@SearchBox("q", "Search shunts and entries")
				<span class="muted" id="n-match" hidden></span>
			</div>
			<div class="list" id="shunt-list">
				@ShuntList(d.Shunts)
			</div>
			<div class="empty" id="empty" hidden>Nothing matches.</div>
		</div>
		<script src="/static/shunts.js"></script>
	}
}

// ShuntList is the content of #shunt-list: one row per shunt, in file order.
templ ShuntList(shunts []ShuntView) {
	if len(shunts) == 0 {
		<div class="empty">No shunts configured. Create one with + New.</div>
	}
	for _, s := range shunts {
		@ShuntRow(s)
	}
}

templ ShuntToggle(s shunt.Shunt) {
	<label class="tg" id={ "toggle-" + SlugID(s.Name) } data-act="tg">
		if s.Enabled {
			<input
				type="checkbox" autocomplete="off"
				checked
				hx-put={ shuntPath(s.Name) + "/disable" }
				hx-target={ "#toggle-" + SlugID(s.Name) }
				hx-swap="outerHTML"
			/>
		} else {
			<input
				type="checkbox" autocomplete="off"
				hx-put={ shuntPath(s.Name) + "/enable" }
				hx-target={ "#toggle-" + SlugID(s.Name) }
				hx-swap="outerHTML"
			/>
		}
		<i></i>
	</label>
}

// ShuntCount is the row head's entry count. oob marks it for an out-of-band
// swap next to an entry list response.
templ ShuntCount(name string, n int, oob bool) {
	<span
		class="num"
		id={ "count-" + SlugID(name) }
		data-n={ itoa(n) }
		if oob {
			hx-swap-oob="true"
		}
	>@Num(n)</span>
}

templ kvCount(name string, n int, oob bool) {
	<b
		id={ "kvcount-" + SlugID(name) }
		if oob {
			hx-swap-oob="true"
		}
	>@Num(n)</b>
}

// ShuntRow is one shunt: the 44 px head and the panel it expands into.
templ ShuntRow(v ShuntView) {
	<div
		id={ "shunt-" + SlugID(v.Name) }
		class={ "row", templ.KV("on", v.Enabled), templ.KV("nodata", v.NoData != ""), templ.KV("open", v.Open) }
		data-name={ v.Name }
		data-desc={ v.Description }
		data-source={ v.Source }
	>
		<div class="head">
			<span class="handle" data-act="drag" title="Drag to reorder"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.8"></circle><circle cx="15" cy="6" r="1.8"></circle><circle cx="9" cy="12" r="1.8"></circle><circle cx="15" cy="12" r="1.8"></circle><circle cx="9" cy="18" r="1.8"></circle><circle cx="15" cy="18" r="1.8"></circle></svg></span>
			<span class="dot"></span>
			<span class="name">
				<span class="t">{ v.Name }</span>
				if v.IsGeosite() {
					<span class="badge" title={ v.Source }>geosite</span>
				}
				if v.NoData != "" {
					<span class="badge red" title="This shunt routes nothing until the geosite database has the category">{ v.NoData }</span>
				}
			</span>
			@ShuntCount(v.Name, v.Count, false)
			if v.Description == "" && v.IsGeosite() {
				<span class="muted desc src">{ v.Source }</span>
			} else {
				<span class="muted desc">{ v.Description }</span>
			}
			@ShuntToggle(v.Shunt)
			@Chevron()
		</div>
		<div class="panel">
			<div class="entries">
				<div class="efilter">
					<input type="search" placeholder={ "Filter " + groupDigits(v.Count) + " entries" } data-act="efilter" autocomplete="off"/>
					<span class="num" data-role="ecount"></span>
				</div>
				if v.IsGeosite() {
					<div
						class="chips ro"
						id={ "entry-items-" + SlugID(v.Name) }
						hx-get={ shuntPath(v.Name) + "/entries" }
						hx-trigger="intersect once"
						hx-swap="innerHTML"
					>
						<span class="none">Loading entries... <span class="spinner"></span></span>
					</div>
					<div class="hint">Read-only: this shunt is the geosite category <code>{ v.Source }</code>. Managed from the <a href="/geosite">Geosite</a> page.</div>
				} else {
					<div class="chips" id={ "entry-items-" + SlugID(v.Name) }>
						@EntryChips(SlugID(v.Name), v.Name, v.Entries, false)
					</div>
					<form
						class="add"
						hx-post={ shuntPath(v.Name) + "/entries/bulk" }
						hx-target={ "#shunt-" + SlugID(v.Name) }
						hx-swap="outerHTML"
						hx-disabled-elt="find textarea, find button[type='submit']"
					>
						<textarea name="values" rows="1" placeholder="domain.com, 1.2.3.4, 10.0.0.0/8" autocomplete="off" required></textarea>
						<button class="btn btn-accent" type="submit">Add</button>
					</form>
					<div class="hint">Prefixes: <code>full:</code> <code>keyword:</code> <code>regexp:</code>. Several at once, separated by commas or newlines.</div>
				}
			</div>
			<div class="meta">
				<form
					hx-put={ shuntPath(v.Name) }
					hx-trigger="change, submit"
					hx-target={ "#shunt-" + SlugID(v.Name) }
					hx-swap="outerHTML"
				>
					<div class="field">
						<label for={ "name-" + SlugID(v.Name) }>Name</label>
						<input type="text" id={ "name-" + SlugID(v.Name) } name="name" value={ v.Name } autocomplete="off" required data-act="rename"/>
					</div>
					<div class="field">
						<label for={ "desc-" + SlugID(v.Name) }>Description</label>
						<input type="text" id={ "desc-" + SlugID(v.Name) } name="description" value={ v.Description } placeholder="Optional" autocomplete="off" data-act="redesc"/>
					</div>
				</form>
				<div class="kv">
					<span>Entries</span>
					@kvCount(v.Name, v.Count, false)
					<span>Position</span>
					<b data-role="pos">{ itoa(v.Pos + 1) } of { itoa(v.Total) }</b>
					if v.IsGeosite() {
						<span>Source</span>
						<b class="src">{ v.Source }</b>
					}
				</div>
				<div class="danger">
					<button type="button" class="btn btn-sm btn-danger" data-act="arm">Delete shunt</button>
					<span class="confirm">
						Delete "{ v.Name }"?
						<button
							type="button"
							class="btn btn-sm btn-danger"
							hx-delete={ shuntPath(v.Name) }
							hx-target={ "#shunt-" + SlugID(v.Name) }
							hx-swap="outerHTML"
						>Delete</button>
						<button type="button" class="btn btn-sm btn-ghost" data-act="disarm">Cancel</button>
					</span>
				</div>
			</div>
		</div>
	</div>
}

// GeositeEntryList is the lazily loaded, read-only entry list of a geosite
// shunt.
templ GeositeEntryList(shuntSlug string, shuntName string, entries []shunt.Entry, noData string) {
	if noData != "" {
		<span class="none">No entries: { noData }.</span>
	} else {
		@EntryChips(shuntSlug, shuntName, entries, true)
	}
}

// EntryChipsUpdate is the answer to an entry removal: the chips plus the
// new count for the row head and the panel, swapped out of band.
templ EntryChipsUpdate(shuntSlug string, shuntName string, entries []shunt.Entry) {
	@EntryChips(shuntSlug, shuntName, entries, false)
	@ShuntCount(shuntName, len(entries), true)
	@kvCount(shuntName, len(entries), true)
}

templ EntryChips(shuntSlug string, shuntName string, entries []shunt.Entry, readOnly bool) {
	if len(entries) == 0 {
		<span class="none">No entries yet.</span>
	}
	for _, e := range sortedEntries(entries) {
		<span class="chip" data-v={ e.Value }>
			<span>{ e.Value }</span>
			if !e.Valid() {
				<span class="badge red" title="Invalid entry, ignored by the DNS matcher and ipset">not applied</span>
			}
			if !readOnly {
				<button
					type="button"
					title="Remove"
					hx-delete={ entryPath(shuntName, e.Value) }
					hx-target={ "#entry-items-" + shuntSlug }
					hx-swap="innerHTML"
				>&times;</button>
			}
		</span>
	}
}
