package templates

import (
	"fmt"

	"github.com/egorlepa/netshunt/internal/healthcheck"
	"github.com/egorlepa/netshunt/internal/platform"
)

templ DiagnosticsPage() {
	@Layout("Diagnostics", "diagnostics") {
		<h1 class="mb-16">Diagnostics</h1>
		<div class="card mb-16">
			<div class="flex-between mb-8">
				<h2>Health Checks</h2>
				<button class="btn btn-sm btn-accent" hx-get="/diagnostics/run" hx-target="#check-results" hx-swap="innerHTML">
					Run Checks
					<span class="htmx-indicator"><span class="spinner"></span></span>
				</button>
			</div>
			<div id="check-results" hx-get="/diagnostics/run" hx-trigger="load" hx-swap="innerHTML">
				<p class="text-muted text-sm">Running checks...</p>
			</div>
		</div>
		<div class="card mb-16">
			<h2 class="mb-8">Domain Probe</h2>
			<p class="text-muted text-sm mb-8">Test if a domain resolves and its IPs are in the ipset.</p>
			<form
				hx-post="/diagnostics/probe"
				hx-target="#probe-results"
				hx-swap="innerHTML"
				hx-disabled-elt="find button[type='submit']"
				class="flex gap-8 stack-sm"
			>
				<input type="text" name="domain" value="ifconfig.me" placeholder="example.com" required/>
				<button class="btn btn-accent" type="submit">
					Test
					<span class="htmx-indicator"><span class="spinner"></span></span>
				</button>
			</form>
			<div id="probe-results" class="mt-8" hx-post="/diagnostics/probe" hx-trigger="load" hx-swap="innerHTML" hx-vals='{"domain":"ifconfig.me"}'>
				<p class="mb-8"><strong>ifconfig.me</strong></p>
				<div class="check-list">
					<div class="check-row">
						<span class="check-icon check-pending"><span class="spinner"></span></span>
						<span class="check-name">resolving…</span>
						<span class="check-detail text-muted">checking ipset</span>
					</div>
				</div>
			</div>
		</div>
		<div class="card mb-16">
			<h2 class="mb-8">Maintenance</h2>
			<div class="flex gap-8 flex-wrap">
				<button class="btn btn-accent" hx-post="/actions/reconcile" hx-swap="none" hx-disabled-elt="this">
					Force Reconcile
					<span class="htmx-indicator"><span class="spinner"></span></span>
				</button>
				<button class="btn btn-accent" hx-post="/actions/restart" hx-swap="none" hx-confirm="Restart dnscrypt-proxy?" hx-disabled-elt="this">
					Restart dnscrypt-proxy
					<span class="htmx-indicator"><span class="spinner"></span></span>
				</button>
			</div>
		</div>
		<div class="card">
			<div class="flex-between mb-8">
				<h2>Logs</h2>
				<button class="btn btn-sm" hx-get="/diagnostics/logs" hx-target="#log-lines" hx-swap="innerHTML">
					Refresh
				</button>
			</div>
			<div id="log-lines" hx-get="/diagnostics/logs" hx-trigger="load" hx-swap="innerHTML">
				<p class="text-muted text-sm">Loading logs...</p>
			</div>
		</div>
	}
}

templ DiagnosticsLogs(entries []platform.LogEntry) {
	if len(entries) == 0 {
		<p class="text-muted text-sm">No log entries.</p>
	} else {
		<div class="log-viewer">
			for _, e := range entries {
				<div class="log-line" onclick="this.classList.toggle('expanded')">
					<span class="log-time">@LocalTime(e.Time, "time")</span>
					<span class={ logLevelClass(e.Level) }>{ e.Level }</span>
					<span class="log-msg" title={ e.Msg }>{ e.Msg }</span>
					if e.Attrs != "" {
						<span class="log-attrs" title={ e.Attrs }>{ e.Attrs }</span>
					}
				</div>
			}
		</div>
	}
}

// DiagnosticsCheckList renders one placeholder row per check with a spinner.
// Each row then fetches its own result via htmx, so the list appears instantly
// and fills in ✓/✗ as each check completes.
templ DiagnosticsCheckList(names []string) {
	<div class="check-list">
		for i, name := range names {
			<div
				class="check-row"
				id={ fmt.Sprintf("check-%d", i) }
				hx-get={ fmt.Sprintf("/diagnostics/run/%d", i) }
				hx-trigger="load"
				hx-swap="outerHTML"
			>
				<span class="check-icon check-pending"><span class="spinner"></span></span>
				<span class="check-name">{ name }</span>
				<span class="check-detail text-muted">checking…</span>
			</div>
		}
	</div>
}

templ DiagnosticsCheckResult(i int, r healthcheck.Result) {
	<div class="check-row" id={ fmt.Sprintf("check-%d", i) }>
		<span class="check-icon">
			if r.Passed {
				<span class="text-green">✓</span>
			} else if r.Warn {
				<span class="text-yellow">!</span>
			} else {
				<span class="text-red">✗</span>
			}
		</span>
		<span class="check-name"><strong>{ r.Name }</strong></span>
		<span class="check-detail text-muted" title={ r.Detail }>{ r.Detail }</span>
	</div>
}

templ DiagnosticsProbeResult(probe healthcheck.ProbeResult) {
	<p class="mb-8"><strong>{ probe.Domain }</strong></p>
	if len(probe.IPs) == 0 {
		<div class="check-row">
			<span class="check-icon"><span class="text-red">✗</span></span>
			<span class="check-detail">no IPs resolved</span>
		</div>
	} else {
		<div class="check-list">
			for _, ip := range probe.IPs {
				<div class="check-row">
					<span class="check-icon">
						if probe.InIPSet[ip] {
							<span class="text-green">✓</span>
						} else {
							<span class="text-red">✗</span>
						}
					</span>
					<span class="check-name mono">{ ip }</span>
					<span class="check-detail text-muted">
						if probe.InIPSet[ip] {
							in ipset
						} else {
							not in ipset
						}
					</span>
				</div>
			}
		</div>
	}
}

templ DiagnosticsProbeError(domain string, errMsg string) {
	<p class="mb-8"><strong>{ domain }</strong></p>
	<p><span class="text-red">✗</span> <span class="text-muted">{ errMsg }</span></p>
}
