package templates

templ Layout(title string, activePage string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } - netshunt</title>
		<link rel="stylesheet" href="/static/style.css"/>
		<script src="/static/htmx.min.js"></script>
	</head>
	<body>
		<div id="nprogress"><div class="bar"></div></div>
		<nav>
			<div class="container">
				<span class="brand">netshunt</span>
				<input type="checkbox" autocomplete="off" id="nav-toggle"/>
				<label class="nav-burger" for="nav-toggle" aria-label="Toggle navigation">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				</label>
				<div class="nav-links">
					<a href="/" if activePage == "dashboard" { class="active" }>Dashboard</a>
					<a href="/shunts" if activePage == "shunts" { class="active" }>Shunts</a>
					<a href="/geosite" if activePage == "geosite" { class="active" }>Geosite</a>
					<a href="/blocklist" if activePage == "blocklist" { class="active" }>Blocklist</a>
					<a href="/diagnostics" if activePage == "diagnostics" { class="active" }>Diagnostics</a>
					<a href="/settings" if activePage == "settings" { class="active" }>Settings</a>
					if AppVersion != "" {
						<span class="ver">v{ AppVersion }</span>
					}
				</div>
			</div>
		</nav>
		<main class="container">
			{ children... }
		</main>
		<div id="toast"></div>
		<script>
			(function() {
				function pad(n) { return n < 10 ? "0" + n : "" + n; }
				function fmt(el) {
					var iso = el.getAttribute("datetime");
					if (!iso) return;
					var d = new Date(iso);
					if (isNaN(d.getTime())) return;
					var hh = pad(d.getHours()), mm = pad(d.getMinutes()), ss = pad(d.getSeconds());
					var abs = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) + " " + hh + ":" + mm;
					var f = el.getAttribute("data-fmt");
					if (f === "time") {
						el.textContent = hh + ":" + mm + ":" + ss;
					} else if (f === "rel") {
						el.textContent = relTime(d, new Date());
						el.title = abs;
					} else {
						el.textContent = abs;
					}
				}
				// relTime mirrors templates.RelTime (Go) in the viewer's time zone.
				function relTime(t, now) {
					var hm = pad(t.getHours()) + ":" + pad(t.getMinutes());
					var day = function(x) { return new Date(x.getFullYear(), x.getMonth(), x.getDate()).getTime(); };
					var days = Math.round((day(now) - day(t)) / 86400000);
					if (t > now || days === 0) return "today " + hm;
					if (days === 1) return "yesterday " + hm;
					if (days < 30) return days + " days ago";
					var months = (now.getFullYear() - t.getFullYear()) * 12 + now.getMonth() - t.getMonth();
					if (now.getDate() < t.getDate()) months--;
					if (months < 1) months = 1;
					if (months < 12) return months === 1 ? "1 month ago" : months + " months ago";
					var years = Math.floor(months / 12);
					return years === 1 ? "1 year ago" : years + " years ago";
				}
				function fmtAll(root) {
					(root || document).querySelectorAll("time[data-fmt]").forEach(fmt);
				}
				window.__fmtLocalTimes = fmtAll;
				document.addEventListener("DOMContentLoaded", function() { fmtAll(); });
				document.body.addEventListener("htmx:afterSwap", function(e) { fmtAll(e.target); });
			})();
			document.body.addEventListener("showToast", function(e) {
				var toast = document.getElementById("toast");
				var d = e.detail;
				var msg = (d && d.message) || "Done";
				var type = (d && d.type) || "success";
				var el = document.createElement("div");
				el.className = "toast-msg toast-" + type;
				el.textContent = msg;
				toast.appendChild(el);
				setTimeout(function() { el.classList.add("toast-hide"); }, 2500);
				setTimeout(function() { el.remove(); }, 3000);
			});
			document.body.addEventListener("htmx:responseError", function(e) {
				var toast = document.getElementById("toast");
				var el = document.createElement("div");
				el.className = "toast-msg toast-error";
				el.textContent = e.detail.xhr.responseText || "Request failed";
				toast.appendChild(el);
				setTimeout(function() { el.classList.add("toast-hide"); }, 2500);
				setTimeout(function() { el.remove(); }, 3000);
			});
			(function() {
				var np = document.getElementById("nprogress");
				var bar = np ? np.querySelector(".bar") : null;
				var active = 0, timer = null;
				function isPoll(elt) {
					if (!elt || !elt.getAttribute) return false;
					var t = elt.getAttribute("hx-trigger") || "";
					return t.indexOf("every ") !== -1;
				}
				function start() {
					if (!np) return;
					active++;
					np.classList.add("active");
					if (bar) bar.style.width = "8%";
					clearInterval(timer);
					var p = 8;
					timer = setInterval(function() {
						p += (90 - p) * 0.12;
						if (bar) bar.style.width = p.toFixed(1) + "%";
					}, 200);
				}
				function done() {
					if (!np) return;
					active = Math.max(0, active - 1);
					if (active > 0) return;
					clearInterval(timer);
					if (bar) bar.style.width = "100%";
					setTimeout(function() {
						np.classList.remove("active");
						setTimeout(function() { if (active === 0 && bar) bar.style.width = "0"; }, 250);
					}, 200);
				}
				// Completion is tied to the XHR itself, not to htmx:afterRequest:
				// that event is dispatched on the element that fired the request,
				// and when the request swaps that element out of the DOM (a button
				// inside the content it replaces)
				// the event never bubbles to body and the bar would stay at 90%.
				document.body.addEventListener("htmx:beforeRequest", function(e) {
					if (isPoll(e.detail.elt)) return;
					start();
					var xhr = e.detail.xhr;
					if (xhr && xhr.addEventListener) {
						xhr.addEventListener("loadend", done, { once: true });
					} else {
						done();
					}
				});
			})();
		</script>
	</body>
	</html>
}
