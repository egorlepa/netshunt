package templates

// SearchBox is the search input of a list bar: magnifier, input, and the
// "/" shortcut hint.
templ SearchBox(id string, placeholder string) {
	<div class="search">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.5" y2="16.5"></line></svg>
		<input id={ id } type="search" placeholder={ placeholder } autocomplete="off"/>
		<kbd>/</kbd>
	</div>
}

// Chevron is the row expander icon.
templ Chevron() {
	<span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></span>
}

