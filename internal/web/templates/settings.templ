package templates

import (
	"strings"

	"github.com/egorlepa/netshunt/internal/config"
)

// SettingsPage is one form of full-width groups; the sticky save bar shows
// whether anything differs from the loaded values (/static/settings.js).
// The Maintenance group is outside the saved values.
templ SettingsPage(cfg *config.Config) {
	@Layout("Settings", "settings") {
		<div id="settings">
			<div class="toolbar plain">
				<h1>Settings</h1>
				<div class="actions">
					<a class="btn" href="/settings/export" download>Export</a>
				</div>
			</div>
			<form id="sform" hx-put="/settings" hx-swap="none" hx-disabled-elt="find .savebar button">
				<div class="group">
					<h2>Routing</h2>
					<div class="field narrow">
						<label for="s-port">Proxy port</label>
						<div class="h">Local transparent proxy. TCP via REDIRECT, UDP via TPROXY. A dead port fails closed.</div>
						<div class="c"><input id="s-port" class="mono" type="number" name="routing_local_port" value={ itoa(cfg.Routing.LocalPort) } min="1" max="65535" autocomplete="off"/></div>
					</div>
					<div class="field">
						<label for="s-excl">Excluded networks</label>
						<div class="h">IPv4 CIDRs that never go through the proxy, one per line. The kill switch returns early for these.</div>
						<div class="c"><textarea id="s-excl" name="excluded_networks" rows="3" spellcheck="false">{ joinLines(cfg.ExcludedNetworks) }</textarea></div>
					</div>
				</div>
				<div class="group">
					<h2>DNS</h2>
					<div class="field narrow">
						<label for="s-listen">Forwarder listen</label>
						<div class="h">Address the built-in forwarder binds. Clients are redirected here on every intercepted interface.</div>
						<div class="c"><input id="s-listen" class="mono" type="text" name="dns_listen_addr" value={ cfg.DNS.ListenAddr } autocomplete="off" spellcheck="false"/></div>
					</div>
					<div class="field">
						<label for="s-up">DoH upstreams</label>
						<div class="h">Every query is sent to all of them, the first valid answer wins. URL with an IP host, then the TLS name. Empty = defaults.</div>
						<div class="c">
							<textarea id="s-up" name="dns_upstreams" rows="3" spellcheck="false" placeholder={ config.FormatDNSUpstreams(config.DefaultDNSUpstreams()) }>{ config.FormatDNSUpstreams(cfg.DNS.Upstreams) }</textarea>
							<div class="after">{ upstreamsNote(cfg.DNS) }</div>
						</div>
					</div>
				</div>
				<div class="group">
					<h2>Network</h2>
					<div class="field narrow">
						<label for="s-if">Entware interface</label>
						<div class="h">The LAN bridge whose traffic is intercepted.</div>
						<div class="c"><input id="s-if" class="mono" type="text" name="net_interface" value={ cfg.Network.EntwareInterface } autocomplete="off" spellcheck="false"/></div>
					</div>
					<div class="field narrow">
						<label for="s-add">Additional interfaces</label>
						<div class="h">One per line. A VPN TUN here gets the same shunts, e.g. awg0.</div>
						<div class="c"><textarea id="s-add" name="additional_interfaces" rows="2" spellcheck="false">{ joinLines(cfg.Network.AdditionalInterfaces) }</textarea></div>
					</div>
					<div class="field narrow">
						<label for="s-ipset">ipset name</label>
						<div class="h">hash:net set shared by every interface and the kill switch.</div>
						<div class="c"><input id="s-ipset" class="mono" type="text" name="ipset_table" value={ cfg.IPSet.TableName } autocomplete="off" spellcheck="false"/></div>
					</div>
				</div>
				<div class="group">
					<h2>Daemon</h2>
					<div class="field narrow">
						<label for="s-web">Web listen</label>
						<div class="h">This UI and the HTTP API. Reachable from LAN and awg0.</div>
						<div class="c"><input id="s-web" class="mono" type="text" name="web_listen" value={ cfg.Daemon.WebListen } autocomplete="off" spellcheck="false"/></div>
					</div>
					<div class="field narrow">
						<label for="s-log">Log level</label>
						<div class="h">Debug also routes library logs into the file.</div>
						<div class="c">
							<select id="s-log" name="log_level" autocomplete="off">
								for _, l := range []string{"debug", "info", "warn", "error"} {
									<option value={ l } if cfg.Daemon.LogLevel == l { selected }>{ l }</option>
								}
							</select>
						</div>
					</div>
				</div>
				<div class="group" id="maint">
					<h2>Maintenance</h2>
					<div class="field">
						<label>Shunts</label>
						<div class="h">YAML export and import live on the Shunts page.</div>
						<div class="c btns">
							<a class="btn btn-sm" href="/shunts/export" download>Export shunts</a>
							<a class="btn btn-sm" href="/shunts?import=1">Import</a>
						</div>
					</div>
				</div>
				<div class="savebar" id="savebar">
					<span class="grow"></span>
					<button class="btn btn-ghost" type="button" id="discard">Discard</button>
					<button class="btn btn-accent" type="submit">
						Save and apply
						<span class="htmx-indicator"><span class="spinner"></span></span>
					</button>
				</div>
			</form>
		</div>
		<script src="/static/settings.js"></script>
	}
}

// upstreamsNote is the line under the DoH upstreams field.
func upstreamsNote(d config.DNSConfig) string {
	if len(d.Upstreams) == 0 {
		names := make([]string, 0, 3)
		for _, u := range config.DefaultDNSUpstreams() {
			names = append(names, u.SNI)
		}
		return "Using defaults: " + strings.Join(names, ", ") + "."
	}
	return plural(len(d.Upstreams), "upstream configured.", "upstreams configured.")
}
