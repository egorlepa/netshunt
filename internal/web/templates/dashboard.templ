package templates

import "github.com/egorlepa/netshunt/internal/healthcheck"

// DashboardStats is the dashboard strip; /api/activity sends it too.
type DashboardStats struct {
	IPs     int    `json:"ips"`     // tracker members (the kernel set as the tracker knows it)
	Domains int    `json:"domains"` // tracked domains
	Shunts  int    `json:"shunts"`  // enabled shunts
	Entries int    `json:"entries"` // entries of the enabled shunts
	KSDrops uint64 `json:"ks_drops"`
}

// Dashboard is the health line, the strip, the live feed of matched answers
// and the last hour's bars. The feed, the bars and the strip are kept
// current by /static/dashboard.js from /api/activity; the health line
// polls /dashboard/health.
templ Dashboard(st DashboardStats) {
	@Layout("Dashboard", "dashboard") {
		<div id="dashboard">
			<div class="toolbar plain">
				<h1>Dashboard</h1>
				<div class="actions">
					<label class="chk"><input type="checkbox" id="live" checked autocomplete="off"/> live</label>
				</div>
			</div>
			<div
				id="hero-wrap"
				hx-get="/dashboard/health"
				hx-trigger="load, every 60s [document.visibilityState === 'visible' && document.getElementById('live').checked]"
				hx-swap="innerHTML"
			>
				<div class="hero">
					<div>
						<div class="state"><span class="dot spin"></span><span>Running checks</span></div>
					</div>
					<div class="side"><a href="/diagnostics">Diagnostics</a></div>
				</div>
			</div>
			<div class="strip" id="dash-strip">
				@DashboardStrip(st)
			</div>
			<div class="two wide">
				<div class="card">
					<div class="ch">Now routing <span class="muted">matched DNS answers, newest first</span><span class="grow"></span><span class="muted" id="feedn"></span></div>
					<div class="feed" id="feed"><div class="empty">No matched answers yet.</div></div>
				</div>
				<div class="card">
					<div class="ch">Shunt activity <span class="muted">queries, last hour</span></div>
					<div class="bars" id="bars"><div class="empty">Nothing yet.</div></div>
					<div class="ch mid">Clients <span class="muted">last hour</span></div>
					<div class="bars" id="clients"><div class="empty">Nothing yet.</div></div>
				</div>
			</div>
		</div>
		<script src="/static/dashboard.js"></script>
	}
}

templ DashboardStrip(st DashboardStats) {
	<span><b data-k="ips">@Num(st.IPs)</b> IPs in set</span>
	<span><b data-k="domains">@Num(st.Domains)</b> tracked domains</span>
	<span title="enabled shunts and their entries"><b data-k="shunts">@Num(st.Shunts)</b> shunts, <b data-k="entries">@Num(st.Entries)</b> entries</span>
	<span title="packets the kill switch dropped: shunted addresses that tried to leave directly"><b data-k="ks_drops">@Num(int(st.KSDrops))</b> kill switch drops</span>
}

// DashboardHealth is the hero line for a healthcheck run: green when every
// check passed, red with the failing checks listed otherwise, yellow when
// only warnings are left.
templ DashboardHealth(res []healthcheck.Result) {
	{{ failing, warning := splitHealth(res) }}
	<div class={ "hero", templ.KV("bad", len(failing) > 0) }>
		<div>
			<div class="state">
				if len(failing) > 0 {
					<span class="dot bad"></span><span>{ plural(len(failing), "check failing", "checks failing") }</span>
				} else if len(warning) > 0 {
					<span class="dot warn"></span><span>{ "All checks passing, " + plural(len(warning), "warning", "warnings") }</span>
				} else {
					<span class="dot on"></span><span>All checks passing</span>
				}
			</div>
			if len(failing) > 0 || len(warning) > 0 {
				<div class="sub">
					for _, r := range append(failing, warning...) {
						<b>{ r.Name }</b>: { sentence(r.Detail) }
					}
				</div>
			}
		</div>
		<div class="side"><a href="/diagnostics">Diagnostics</a></div>
	</div>
}
