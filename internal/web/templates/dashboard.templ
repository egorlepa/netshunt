package templates

import "github.com/egorlepa/netshunt/internal/config"

type DashboardData struct {
	IPSetCount        int
	ShuntCount        int
	EnabledShuntCount int
	EntryCount        int
	TrackedDomains    int
	TrackedIPs        int
	Routing           config.RoutingConfig
	Version           string
}

templ Dashboard(data DashboardData) {
	@Layout("Dashboard", "dashboard") {
		<div class="flex-between mb-16">
			<h1>Dashboard</h1>
			<div class="flex gap-8" style="align-items:center">
				<span id="dash-poll-indicator" class="htmx-indicator"><span class="spinner"></span></span>
				<span class="text-muted text-sm">v{ data.Version }</span>
			</div>
		</div>
		<div id="dashboard-content" hx-get="/dashboard-content" hx-trigger="every 10s" hx-swap="innerHTML" hx-indicator="#dash-poll-indicator">
			@DashboardContent(data)
		</div>
	}
}

templ DashboardContent(data DashboardData) {
	<div class="card">
		<div class="flex-between mb-16">
			<h2>Overview</h2>
			<button class="btn btn-sm" hx-get="/dashboard-content" hx-target="#dashboard-content" hx-swap="innerHTML">
				Refresh
				<span class="htmx-indicator"><span class="spinner"></span></span>
			</button>
		</div>
		<div class="stat-grid">
			<div class="stat">
				<div class="stat-label">IPSet entries</div>
				<div class="stat-value">{ itoa(data.IPSetCount) }</div>
			</div>
			<div class="stat">
				<div class="stat-label">Shunts enabled</div>
				<div class="stat-value">{ itoa(data.EnabledShuntCount) } <span class="stat-sub">/ { itoa(data.ShuntCount) }</span></div>
			</div>
			<div class="stat">
				<div class="stat-label">Host entries</div>
				<div class="stat-value">{ itoa(data.EntryCount) }</div>
			</div>
			<div class="stat">
				<div class="stat-label">Tracked domains</div>
				<div class="stat-value">{ itoa(data.TrackedDomains) }</div>
			</div>
			<div class="stat">
				<div class="stat-label">Tracked IPs</div>
				<div class="stat-value">{ itoa(data.TrackedIPs) }</div>
			</div>
		</div>
	</div>
	<div class="card">
		<h2 class="mb-16">Active proxy</h2>
		@ProxySwitch(data.Routing)
	</div>
}

templ ProxySwitch(r config.RoutingConfig) {
	<span id="proxy-switch">
		if !r.BackupConfigured() {
			<strong>primary</strong> <span class="text-muted">({ itoa(r.LocalPort) })</span>
			<span class="text-muted text-sm"> — backup not configured</span>
		} else {
			<span class="flex gap-8" style="align-items:center">
				if !r.UseBackup {
					<strong>primary</strong>
				} else {
					<span class="text-muted">primary</span>
				}
				<span class="text-muted">({ itoa(r.LocalPort) })</span>
				<label class="toggle" title="Switch between primary and backup proxy">
					if r.UseBackup {
						<input
							type="checkbox" checked
							hx-post="/actions/switch-proxy"
							hx-target="#proxy-switch"
							hx-swap="outerHTML"
							hx-disabled-elt="this"
						/>
					} else {
						<input
							type="checkbox"
							hx-post="/actions/switch-proxy"
							hx-target="#proxy-switch"
							hx-swap="outerHTML"
							hx-disabled-elt="this"
						/>
					}
					<span class="slider"></span>
				</label>
				if r.UseBackup {
					<strong>backup</strong>
				} else {
					<span class="text-muted">backup</span>
				}
				<span class="text-muted">({ itoa(r.BackupPort) })</span>
			</span>
		}
	</span>
}
